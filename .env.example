# ── Catalyst — Environment Variables ──
# Copy this file to .env and fill in the values you need.

# ── Data Directory ──
# Root directory for all local state: database and files (default: .data/)
# CATALYST_STORAGE_PATH=.data

# ── Authentication ──
# Mode: "none" | "entra" | "oauth" (default: "entra" for HTTP mode)
# Dev mode (--dev) runs with no auth.
# CATALYST_AUTH_MODE=entra

# ── Entra ID (when AUTH_MODE=entra) ──
# CATALYST_AUTH_ENTRA_INSTANCE=https://login.microsoftonline.com/
# CATALYST_AUTH_ENTRA_TENANT_ID=
# CATALYST_AUTH_ENTRA_CLIENT_ID=
# CATALYST_AUTH_ENTRA_CLIENT_SECRET=
# CATALYST_AUTH_ENTRA_AUDIENCE=api://<client-id>
# CATALYST_AUTH_ENTRA_REDIRECT_URI=http://localhost:5000/oauth/callback

# ── Generic OAuth / OIDC (when AUTH_MODE=oauth) ──
# CATALYST_AUTH_OAUTH_ISSUER=https://accounts.google.com
# CATALYST_AUTH_OAUTH_CLIENT_ID=
# CATALYST_AUTH_OAUTH_CLIENT_SECRET=
# CATALYST_AUTH_OAUTH_AUDIENCE=
# CATALYST_AUTH_OAUTH_SCOPES=openid email profile
# CATALYST_AUTH_OAUTH_EMAIL_CLAIM=email
# CATALYST_AUTH_OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback

# ── Pre-registered OAuth clients (optional) ──
# JSON array of clients that bypass DCR scheme validation (allows custom URI schemes like cursor://).
# Each entry: { "clientId": "...", "clientName": "...", "redirectUris": ["..."], "clientSecret": "..." }
# clientSecret and clientName are optional.
# CATALYST_AUTH_PRE_REGISTERED_CLIENTS=[{"clientId":"example","redirectUris":["cursor://app/callback"]}]

# ── Web Session Secret ──
# Change this in production. Used to sign the session cookie.
# CATALYST_SESSION_SECRET=change-me-in-production
