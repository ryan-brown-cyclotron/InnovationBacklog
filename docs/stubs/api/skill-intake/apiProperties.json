{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aadcertificate",
          "clientId": "REPLACE-WITH-CLIENT-ID",
          "scopes": [
            "api://REPLACE-WITH-CLIENT-ID/user_impersonation"
          ],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "AzureActiveDirectoryResourceId": "api://REPLACE-WITH-CLIENT-ID",
            "IsOnbehalfofLoginSupported": true
          },
          "customParameters": {
            "loginUri": {
              "value": "https://login.microsoftonline.com"
            },
            "tenantId": {
              "value": "REPLACE-WITH-TENANT-ID"
            },
            "resourceUri": {
              "value": "api://REPLACE-WITH-CLIENT-ID"
            },
            "enableOnbehalfOfLogin": {
              "value": true
            }
          }
        }
      },
      "functionKey": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "Function key",
          "description": "Host key for the function app. The transport gate that sits in front of the identity layer; it says nothing about who is calling.",
          "tooltip": "az functionapp keys list -g <rg> -n <app> --query functionKeys.default -o tsv",
          "constraints": {
            "tabIndex": 2,
            "clearText": false,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#0B5CAB",
    "capabilities": [],
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Set x-functions-key",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "x-functions-key",
          "x-ms-apimTemplateParameter.value": "@connectionParameters('functionKey')",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      }
    ]
  }
}
